<% content_for :title, "Sign in — DaySignal" %>

<section class="panel">
  <h1>Sign in</h1>

  <% if flash[:alert] %>
    <div class="flash flash-alert"><%= flash[:alert] %></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="flash flash-notice"><%= flash[:notice] %></div>
  <% end %>

  <%= form_with url: session_path, class: "stack" do |form| %>
    <label>
      Email
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </label>
    <label>
      Password
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
    </label>
    <%= form.button "Sign in", type: :submit, class: "button" %>
  <% end %>

  <p class="muted">
    <%= link_to "Forgot password?", new_password_path %>
    ·
    <%= link_to "Create an account", new_registration_path %>
  </p>
</section>
