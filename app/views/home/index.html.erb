<% content_for :title, "WeatherCheck" %>

<section class="panel">
  <h1>WeatherCheck</h1>
  <p class="lede">Timezone-aware weather alert delivery. Thresholds decided by code — not an LLM.</p>

  <% if @user %>
    <p class="status"><%= @user.alert_status_summary %></p>
    <% if @user.preferences_complete? %>
      <p class="muted">
        <%= @user.location_label %>
        (<%= number_with_precision(@user.latitude, precision: 4) %>,
         <%= number_with_precision(@user.longitude, precision: 4) %>)
        · threshold <%= @user.rain_threshold %>%
      </p>
    <% end %>
    <p>
      <%= link_to "Edit preferences", edit_preferences_path, class: "button" %>
    </p>
  <% else %>
    <p>
      <%= link_to "Sign up", new_registration_path, class: "button" %>
      <%= link_to "Sign in", new_session_path, class: "button button-secondary" %>
    </p>
  <% end %>
</section>
