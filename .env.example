# Copy to `.env` at the repo root and fill in real values.
# Never commit `.env`.

# --- Database (Docker Compose service `db`) ---
POSTGRES_DB=WeatherCheck
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
# Local Docker maps host 5433 → container 5432 (see docker-compose.yml).
POSTGRES_PORT=5433
DATABASE_URL=postgres://postgres:your_password_here@localhost:5433/weather_check_development

# --- Redis (Sidekiq) ---
REDIS_URL=redis://localhost:6379/0

# --- Weather (needed from Step 2 live fetch; stubbed in tests) ---
WEATHER_PROVIDER=openweathermap
WEATHER_API_KEY=your_openweathermap_key_here

# --- Mail ---
# letter_opener (dev browser) or smtp (real delivery, e.g. Gmail app password)
MAILER_DELIVERY_METHOD=letter_opener
MAILER_FROM=alerts@example.com
SUPPORT_EMAIL=you@example.com
APP_HOST=localhost:3000

SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your_app_password_here
EMAIL_HOST_USER=you@example.com
