# Secrets — never commit
.env
.env.*
!.env.example
docs/.env
/config/master.key
/config/credentials/*.key

# Bundler / Ruby
/.bundle
/vendor/bundle
*.gem

# Rails (will apply once app is generated)
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/storage/*
!/storage/.keep
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules
/yarn-error.log
/yarn-debug.log*
.yarn-integrity

# OS / editor
.DS_Store
*.swp
*~
.idea/
.vscode/

# Ignore key files for decrypting credentials and more.
/config/*.key

